# --- App ---
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:4200

# --- Database ---
DATABASE_URL=postgresql://immo:changeme@localhost:5432/immo_db

# --- JWT ---
JWT_ACCESS_SECRET=change-this-access-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_REFRESH_EXPIRES_IN=30d

# --- Security ---
BCRYPT_SALT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Uploads ---
UPLOADS_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# --- Frontend links (used for logged email stubs) ---
FRONTEND_URL=http://localhost:4200

# --- Postgres (docker-compose) ---
POSTGRES_PASSWORD=changeme
